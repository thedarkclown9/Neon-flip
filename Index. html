<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>Neon Flip: Cyber Dodger</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
      -webkit-user-select: none;
      touch-action: none;
    }
    body, html {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: #030712;
      font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      color: #f3f4f6;
    }
    #game-container {
      position: relative;
      width: 100vw;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      background: radial-gradient(circle at center, #0f172a 0%, #030712 100%);
    }
    canvas {
      display: block;
      width: 100%;
      height: 100%;
    }
    .hud {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      padding: 16px 24px;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      pointer-events: none;
      z-index: 10;
    }
    .hud-left {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .score-container {
      font-size: 32px;
      font-weight: 800;
      letter-spacing: 2px;
      color: #00f0ff;
      text-shadow: 0 0 12px rgba(0, 240, 255, 0.6);
    }
    .best-score {
      font-size: 13px;
      font-weight: 600;
      color: #94a3b8;
      letter-spacing: 1px;
    }
    .warp-badge {
      display: inline-block;
      margin-top: 4px;
      font-size: 11px;
      font-weight: 700;
      color: #ff007f;
      background: rgba(255, 0, 127, 0.15);
      border: 1px solid rgba(255, 0, 127, 0.4);
      padding: 2px 8px;
      border-radius: 12px;
      width: fit-content;
      letter-spacing: 1px;
    }
    .hud-right {
      display: flex;
      align-items: center;
      gap: 12px;
      pointer-events: auto;
    }
    .coin-pill {
      background: rgba(15, 23, 42, 0.8);
      border: 1px solid rgba(255, 215, 0, 0.4);
      padding: 6px 14px;
      border-radius: 20px;
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 700;
      color: #ffd700;
      box-shadow: 0 0 12px rgba(255, 215, 0, 0.2);
    }
    .icon-btn {
      background: rgba(15, 23, 42, 0.8);
      border: 1px solid #334155;
      color: #94a3b8;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      display: flex;
      justify-content: center;
      align-items: center;
      cursor: pointer;
      transition: all 0.2s;
    }
    .icon-btn:hover {
      border-color: #00f0ff;
      color: #00f0ff;
      transform: scale(1.05);
    }
    .overlay {
      position: absolute;
      inset: 0;
      background: rgba(3, 7, 18, 0.85);
      backdrop-filter: blur(8px);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      z-index: 20;
      opacity: 1;
      transition: opacity 0.3s ease;
    }
    .overlay.hidden {
      opacity: 0;
      pointer-events: none;
    }
    .modal-card {
      background: #0b1329;
      border: 1px solid #1e293b;
      border-radius: 20px;
      padding: 32px 40px;
      text-align: center;
      max-width: 440px;
      width: 90%;
      box-shadow: 0 0 30px rgba(0, 240, 255, 0.15), inset 0 0 20px rgba(15, 23, 42, 0.8);
      position: relative;
    }
    .title-logo {
      font-size: 38px;
      font-weight: 900;
      line-height: 1.1;
      margin-bottom: 8px;
      letter-spacing: 2px;
      background: linear-gradient(135deg, #00f0ff 0%, #ff007f 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      text-shadow: 0 0 20px rgba(0, 240, 255, 0.3);
    }
    .subtitle {
      color: #94a3b8;
      font-size: 14px;
      margin-bottom: 24px;
      letter-spacing: 1px;
    }
    .btn {
      width: 100%;
      padding: 14px 20px;
      border: none;
      border-radius: 12px;
      font-size: 16px;
      font-weight: 700;
      letter-spacing: 1px;
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      margin-bottom: 12px;
    }
    .btn-primary {
      background: linear-gradient(135deg, #00f0ff, #0077fe);
      color: #030712;
      box-shadow: 0 0 20px rgba(0, 240, 255, 0.4);
    }
    .btn-primary:hover {
      box-shadow: 0 0 28px rgba(0, 240, 255, 0.7);
      transform: translateY(-2px);
    }
    .btn-reward {
      background: linear-gradient(135deg, #ff007f, #9900ff);
      color: #fff;
      box-shadow: 0 0 20px rgba(255, 0, 127, 0.4);
    }
    .btn-reward:hover {
      box-shadow: 0 0 28px rgba(255, 0, 127, 0.7);
      transform: translateY(-2px);
    }
    .btn-hangar {
      background: rgba(30, 41, 59, 0.8);
      color: #38bdf8;
      border: 1px solid rgba(56, 189, 248, 0.4);
    }
    .btn-hangar:hover {
      background: rgba(56, 189, 248, 0.15);
      border-color: #38bdf8;
    }
    .btn-secondary {
      background: #1e293b;
      color: #e2e8f0;
      border: 1px solid #334155;
    }
    .btn-secondary:hover {
      background: #334155;
    }
    .hangar-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
      gap: 12px;
      margin: 20px 0;
      max-height: 260px;
      overflow-y: auto;
      padding: 4px;
    }
    .hangar-card {
      background: #0f172a;
      border: 1px solid #1e293b;
      border-radius: 12px;
      padding: 12px 8px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      transition: all 0.2s;
    }
    .hangar-card.active {
      border-color: #00f0ff;
      box-shadow: 0 0 12px rgba(0, 240, 255, 0.4);
    }
    .hangar-card canvas {
      width: 60px;
      height: 60px;
    }
    .hangar-card .skin-name {
      font-size: 12px;
      font-weight: 700;
    }
    .hangar-card .skin-action {
      font-size: 11px;
      padding: 4px 8px;
      border-radius: 6px;
      border: none;
      font-weight: bold;
      width: 100%;
      cursor: pointer;
    }
    .ad-banner-placeholder {
      margin-top: 14px;
      font-size: 11px;
      color: #64748b;
      border: 1px dashed #334155;
      padding: 8px;
      border-radius: 8px;
    }
    .instructions {
      font-size: 13px;
      color: #64748b;
      margin-top: 10px;
    }
    .instructions kbd {
      background: #1e293b;
      padding: 2px 6px;
      border-radius: 4px;
      color: #cbd5e1;
      border: 1px solid #334155;
    }
  </style>
</head>
<body>
  <div id="game-container">
    <canvas id="gameCanvas"></canvas>

    <div class="hud">
      <div class="hud-left">
        <div class="score-container" id="currentScore">0</div>
        <div class="best-score" id="highScoreText">BEST: 0</div>
        <div class="warp-badge" id="warpBadge">VELOCITY 
